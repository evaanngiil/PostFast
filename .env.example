# ==== LLMs (Google Gemini) ====
GENAI_API_KEY=

# ==== Supabase ====
SUPABASE_URL=
# Clave PRIVILEGIADA de backend (service role / secret). NUNCA exponer al navegador.
SUPABASE_KEY=
# Clave PÚBLICA (anon) que /config entrega al frontend para Realtime.
SUPABASE_ANON_KEY=
# Checkpointer de LangGraph (Supavisor modo transacción, puerto 6543)
SUPABASE_CONN_STRING=

# ==== Celery / Redis ====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ==== LinkedIn OAuth ====
LI_CLIENT_ID=
LI_CLIENT_SECRET=
BASE_URL=http://localhost:3000
FASTAPI_URL=http://localhost:8000
SECRET_KEY=

# ==== Búsqueda web (tendencias + verificación de claims externos) ====
TAVILY_API_KEY=

# ==== Observabilidad (opcional, recomendado para la evaluación) ====
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=AIPost

# ==== Flags de la aplicación ====
# Habilita los tokens 'mock_*' de demostración del TFG. SOLO en local.
AIPOST_DEMO_MODE=false
# vinculadas al usuario; 'false' = modo auditoría (solo registra en logs).
AIPOST_ENFORCE_ORG_ACCESS=true

# AIPOST_CHECKPOINTER=postgres
# Directorio de PDFs subidos
# AIPOST_UPLOAD_DIR=
